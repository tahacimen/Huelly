# Copy this file to android/keystore.properties and fill in your real values.
#
#   cp keystore.properties.example keystore.properties
#
# keystore.properties is gitignored on purpose. Never commit it, and never
# commit the .jks file itself — anyone holding both can publish updates to
# your app. Keep an offline backup of the .jks: if you lose it, Google Play
# will not let you update this app ever again, under any circumstances.

# Path to your keystore, relative to the android/ folder (or an absolute path).
storeFile=huelly-release.jks

# The password you set for the keystore itself.
storePassword=

# The alias you gave the key inside the keystore.
keyAlias=huelly

# The password for that key (often the same as storePassword).
keyPassword=
